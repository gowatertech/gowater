# Configuración de Base de Datos
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/gowater

# Configuración para Empresas (Multi-tenant)
COMPANY_DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/gowater

# Configuración para Plataforma
PLATFORM_DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/gowater

# Secreto para Sesiones
SESSION_SECRET=tu_secreto_para_sesiones_aqui

# Puerto para el servidor (opcional, por defecto es 3000)
PORT=3000

# Entorno (development, production, test)
NODE_ENV=development