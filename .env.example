# Configuración de Base de Datos
DATABASE_URL=postgresql://username:password@localhost:5432/gowater
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=password
PGDATABASE=gowater
PGPORT=5432

# Configuración del Servidor
PORT=3000
NODE_ENV=development
SESSION_SECRET=my_secret_session_key_change_in_production

# Configuración de la Plataforma
PLATFORM_DATABASE_URL=postgresql://username:password@localhost:5432/gowater_platform

# Stripe (opcional - para pagos)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Configuración de Email (opcional)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=

# Configuración de almacenamiento de archivos (opcional)
# STORAGE_TYPE=local | s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=