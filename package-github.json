{
  "name": "gowater",
  "version": "1.0.0",
  "description": "Plataforma multi-tenant para gestión de rutas de vehículos y productos",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --platform=node --bundle --outfile=dist/server/index.js --external:express --external:pg --external:connect-pg-simple",
    "start": "node dist/server/index.js",
    "check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/scripts/seed.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tu-usuario/gowater.git"
  },
  "keywords": [
    "logística",
    "rutas",
    "distribución",
    "agua",
    "multi-tenant",
    "react",
    "typescript",
    "express",
    "tailwind",
    "postgresql"
  ],
  "author": "GoWater Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tu-usuario/gowater/issues"
  },
  "homepage": "https://github.com/tu-usuario/gowater#readme",
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@neondatabase/serverless": "^0.8.1",
    "@tanstack/react-query": "^5.22.4",
    "bcrypt": "^5.1.1",
    "class-variance-authority": "^0.7.0",
    "connect-pg-simple": "^9.0.1",
    "date-fns": "^3.3.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.29.3",
    "drizzle-zod": "^0.5.1",
    "express": "^4.18.2",
    "express-session": "^1.18.0",
    "i18next": "^23.10.0",
    "leaflet": "^1.9.4",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.50.1",
    "react-i18next": "^14.0.5", 
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.1",
    "wouter": "^3.0.0",
    "zod": "^3.22.4",
    "zustand": "^4.5.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/leaflet": "^1.9.8",
    "@types/node": "^20.11.20",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^18.2.58",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "drizzle-kit": "^0.20.13",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,md,json}": [
      "prettier --write"
    ]
  }
}